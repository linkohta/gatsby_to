{
  "compilerOptions": {
    "baseUrl": "./src",
    "paths": {
      "~/*": ["*"],
      // このパッケージは Prettier 2 に依存している。ルートの Prettier 3 の型定義ではなく、
      // Prettier 2 の型定義（@types/prettier）で解決されるようにする
      "prettier": [
        "../node_modules/@types/prettier",
        "../../../node_modules/@types/prettier"
      ]
    },
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "moduleResolution": "node",
    "module": "ESNext",
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true
  },
  "include": ["src"],
  "typeRoots": ["../../types", "**/node_modules/@types", "node_modules/@types"]
}
