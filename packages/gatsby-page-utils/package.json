{
  "name": "gatsby-page-utils",
  "version": "3.17.0-next.0",
  "description": "Gatsby library that helps creating pages",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./*": "./dist/*.js"
  },
  "scripts": {
    "build": "babel src --out-dir dist/ --ignore \"**/__tests__\" --extensions \".ts\"",
    "typegen": "rimraf --glob \"dist/**/*.d.ts\" && node ../../scripts/tsc-native.js --emitDeclarationOnly --declaration --declarationDir dist/",
    "watch": "babel -w src --out-dir dist/ --ignore \"**/__tests__\" --extensions \".ts\"",
    "prepare": "cross-env NODE_ENV=production npm run build && npm run typegen"
  },
  "keywords": [
    "gatsby"
  ],
  "author": "Yvonnick FRIN <frin.yvonnick@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/gatsbyjs/gatsby.git",
    "directory": "packages/gatsby-page-utils"
  },
  "homepage": "https://github.com/gatsbyjs/gatsby/tree/master/packages/gatsby-page-utils#readme",
  "dependencies": {
    "@babel/runtime": "^7.29.15",
    "bluebird": "^3.7.2",
    "chokidar": "^6.0.0",
    "fs-exists-cached": "^1.0.0",
    "gatsby-core-utils": "^4.17.0-next.0",
    "glob": "^7.2.3",
    "lodash": "^4.18.1",
    "micromatch": "^4.0.5"
  },
  "devDependencies": {
    "@babel/cli": "^8.1.0",
    "@babel/core": "^8.1.3",
    "@types/micromatch": "^4.0.10",
    "babel-preset-gatsby-package": "^3.17.0-next.0",
    "cross-env": "^10.1.0",
    "rimraf": "^6.1.4",
    "typescript": "^6.0.3"
  },
  "files": [
    "dist/"
  ],
  "engines": {
    "node": "^22.22.2 || ^24.15.0"
  }
}
