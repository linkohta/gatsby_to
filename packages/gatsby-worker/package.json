{
  "name": "gatsby-worker",
  "description": "Utility to create worker pools",
  "version": "2.17.0-next.0",
  "author": "Michal Piechowiak<misiek.piechowiak@gmail.com>",
  "bugs": {
    "url": "https://github.com/gatsbyjs/gatsby/issues"
  },
  "dependencies": {
    "@babel/core": "^8.1.3",
    "@babel/runtime": "^8.1.3",
    "fs-extra": "^11.4.1",
    "signal-exit": "^4.1.0"
  },
  "devDependencies": {
    "@babel/cli": "^8.1.0",
    "@babel/register": "^8.1.2",
    "babel-preset-gatsby-package": "^3.17.0-next.0",
    "cross-env": "^10.1.0",
    "rimraf": "^6.1.4",
    "typescript": "^6.0.3"
  },
  "homepage": "https://github.com/gatsbyjs/gatsby/tree/master/packages/gatsby-worker#readme",
  "keywords": [
    "gatsby",
    "worker"
  ],
  "license": "MIT",
  "main": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/gatsbyjs/gatsby.git",
    "directory": "packages/gatsby-worker"
  },
  "scripts": {
    "build": "babel src --out-dir dist/ --ignore \"**/__tests__\" --extensions \".ts,.js\"",
    "prepare": "cross-env NODE_ENV=production npm run build && npm run typegen",
    "watch": "babel -w src --out-dir dist/ --ignore \"**/__tests__\"  --extensions \".ts,.js\"",
    "typegen": "rimraf --glob \"dist/**/*.d.ts\" && node ../../scripts/tsc-native.js --emitDeclarationOnly --declaration --declarationDir dist/"
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0"
  }
}
