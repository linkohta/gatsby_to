exports[`babel-preset-gatsby-package in node mode applies @babel/preset-react only outside of .ts files 1`] = `
Array [
  Object {
    "exclude": /\\\\\\.ts\\$/,
    "presets": Array [
      Array [
        "@babel/preset-react",
        Object {
          "runtime": "classic",
        },
      ],
    ],
  },
  Object {
    "plugins": Array [
      "@babel/plugin-transform-typescript",
    ],
    "test": Array [
      "**/*.ts",
      "**/*.tsx",
    ],
  },
  Object {
    "plugins": Array [
      "@babel/plugin-transform-react-pure-annotations",
    ],
    "test": /\\\\\\.ts\\$/,
  },
]
`;

